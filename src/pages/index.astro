---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import WorkList from '../components/WorkList.astro';
import About from '../components/About.astro';
import Timeline from '../components/Timeline.astro';
import Toolkit from '../components/Toolkit.astro';
import Approach from '../components/Approach.astro';
import Contact from '../components/Contact.astro';
import { getImage } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import { SITE } from '../site';
import { OG_IMAGE, ids } from '../seo';

const id = ids(Astro.site!);
const photo = new URL((await getImage({ src: portrait, ...OG_IMAGE })).src, Astro.site).href;

// The home page is a ProfilePage about one Person, who works for (and
// co-founded) one Organization. Linked by @id so search engines resolve
// "Joshua Anton Magbanua" and "NightPatch Dev" as two connected entities.
const person = {
  '@type': 'Person',
  '@id': id.person,
  name: SITE.name,
  alternateName: SITE.alternateNames,
  givenName: 'Joshua Anton',
  familyName: 'Magbanua',
  url: id.home,
  image: photo,
  email: `mailto:${SITE.email}`,
  jobTitle: 'Full Stack Developer',
  description:
    'Full Stack Developer based in Kabankalan City, Philippines, and CFO and co-founder of NightPatch Dev, a software development agency. Builds business systems and websites for local companies.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kabankalan City',
    addressRegion: 'Negros Occidental',
    addressCountry: 'PH',
  },
  worksFor: { '@id': id.org },
  hasOccupation: {
    '@type': 'Occupation',
    name: 'Full Stack Developer',
    occupationLocation: { '@type': 'Country', name: 'Philippines' },
  },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of St. La Salle' },
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'degree',
    name: 'BS Information Technology, Web and Mobile Application Development',
    recognizedBy: { '@type': 'CollegeOrUniversity', name: 'University of St. La Salle' },
  },
  award: "Dean's List Academic Achievement Award",
  knowsAbout: [
    'React', 'Next.js', 'Astro', 'TypeScript', 'JavaScript', 'Tailwind CSS', 'Node.js', 'PHP',
    'MySQL', 'PostgreSQL', 'Supabase', 'Prisma', 'Flutter', 'Dart',
    'Full Stack Development', 'Web Design', 'Mobile App Development',
  ],
  knowsLanguage: ['English', 'Filipino'],
  sameAs: SITE.socials.map((s) => s.href),
};

const org = {
  '@type': 'Organization',
  '@id': id.org,
  name: SITE.org.name,
  url: SITE.org.url,
  logo: 'https://www.nightpatchdev.online/icon.png',
  description: SITE.org.description,
  founder: { '@id': id.person },
};
---

<Base
  pageType="ProfilePage"
  pageExtra={{ mainEntity: { '@id': id.person }, about: { '@id': id.person } }}
  schema={[person, org]}
>
  <Hero />
  <WorkList />
  <About />
  <Timeline />
  <Toolkit />
  <Approach />
  <Contact />
</Base>
