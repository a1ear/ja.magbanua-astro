---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
// The hero headline is the LCP element, so its font is fetched up front.
import displayFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

type Props = Parameters<typeof Seo>[0];
const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#141E30" />
    <!-- Google Search Console ownership. One tag per verified property:
         the first is the old Vercel address, the second the new site. -->
    <meta name="google-site-verification" content="RLQEzqRa4pHIf7HP4H5zx-ECyp9D4em97zbtcTJ6HOA" />
    <meta name="google-site-verification" content="dwEBkehrBSJj0HFtgt2a4gLbQGGSgIWIvyvFcbNLSjg" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <Seo {...props} />

    <!-- Runs before first paint so a stored theme never flashes the wrong one. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="bg-accent text-on-accent fixed top-2 left-2 z-[100] -translate-y-[200%] px-4 py-2 font-medium focus:translate-y-0"
      >Skip to content</a
    >
    <Header />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
