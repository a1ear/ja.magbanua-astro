---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultOg from '../assets/portrait-wide.jpg';
import { SITE } from '../site';
import { OG_IMAGE, ids } from '../seo';

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** schema.org type of this page: ProfilePage on home, WebPage elsewhere. */
  pageType?: string;
  /** Extra fields for the page node (e.g. mainEntity). */
  pageExtra?: Record<string, unknown>;
  /** Trail from home to this page, home first. Omit on home. */
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD nodes for this page (Person, a project, ...). */
  schema?: Record<string, unknown>[];
}

const {
  title = SITE.title,
  description = SITE.description,
  image = defaultOg,
  imageAlt = 'Joshua Anton Magbanua standing on a bridge walkway at dusk',
  type = 'website',
  noindex = false,
  pageType = 'WebPage',
  pageExtra = {},
  breadcrumbs,
  schema = [],
} = Astro.props;

const site = Astro.site!;
const id = ids(site);
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), site)
  .href;
const og = await getImage({ src: image, ...OG_IMAGE });
const ogUrl = new URL(og.src, site).href;
const ogHeight = Math.round((OG_IMAGE.width / image.width) * image.height);

// One linked graph per page: the site, this page, its main image, the
// breadcrumb trail, plus whatever the page adds. Nodes reference each other
// by @id, so search engines read them as one connected description.
const graph = [
  {
    '@type': 'WebSite',
    '@id': id.website,
    url: id.home,
    name: SITE.name,
    alternateName: SITE.alternateNames,
    description: SITE.description,
    inLanguage: 'en',
    publisher: { '@id': id.person },
  },
  {
    '@type': pageType,
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': id.website },
    primaryImageOfPage: { '@id': `${canonical}#primaryimage` },
    ...(breadcrumbs && { breadcrumb: { '@id': `${canonical}#breadcrumb` } }),
    ...pageExtra,
  },
  {
    '@type': 'ImageObject',
    '@id': `${canonical}#primaryimage`,
    url: ogUrl,
    contentUrl: ogUrl,
    width: OG_IMAGE.width,
    height: ogHeight,
    caption: imageAlt,
  },
  ...(breadcrumbs
    ? [
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonical}#breadcrumb`,
          itemListElement: breadcrumbs.map((c, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: c.name,
            item: new URL(c.path, site).href,
          })),
        },
      ]
    : []),
  ...schema,
  // Every page names the person behind the site, not only the home page.
  // Home supplies the full Person node; elsewhere a short one with the same
  // @id is added so the name and its variants appear on every indexed page.
  ...(schema.some((n) => n['@id'] === id.person)
    ? []
    : [
        {
          '@type': 'Person',
          '@id': id.person,
          name: SITE.name,
          alternateName: SITE.alternateNames,
          url: id.home,
          jobTitle: SITE.role,
          sameAs: SITE.socials.map((s) => s.href),
        },
      ]),
];
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<title>{title}</title>
<meta name="description" content={description} />
{
  noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <>
      <link rel="canonical" href={canonical} />
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    </>
  )
}
<meta name="author" content={SITE.name} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={String(OG_IMAGE.width)} />
<meta property="og:image:height" content={String(ogHeight)} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="en_PH" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
